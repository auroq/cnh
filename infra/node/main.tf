data "digitalocean_project" "cnh" {
  name = "cnh"
}

data "digitalocean_vpc" "cnh" {
  name = var.vpc_name
}

resource "digitalocean_ssh_key" "operator" {
  name       = "${var.name}-operator"
  public_key = trimspace(file(pathexpand(var.ssh_public_key_path)))
}

resource "digitalocean_droplet" "node" {
  name       = var.name
  region     = var.region
  size       = var.size
  image      = var.image
  vpc_uuid   = data.digitalocean_vpc.cnh.id
  ssh_keys   = [digitalocean_ssh_key.operator.fingerprint]
  monitoring = true
  tags       = ["wide-door", "post-event"]

  user_data = templatefile("${path.module}/cloud-init.yaml.tftpl", {
    microk8s_channel = var.microk8s_channel
  })

  lifecycle {
    ignore_changes = [user_data]
  }
}

resource "digitalocean_firewall" "node" {
  name        = var.name
  droplet_ids = [digitalocean_droplet.node.id]

  dynamic "inbound_rule" {
    for_each = toset(["22", "80", "443", "16443"])
    content {
      protocol         = "tcp"
      port_range       = inbound_rule.value
      source_addresses = ["0.0.0.0/0", "::/0"]
    }
  }

  outbound_rule {
    protocol              = "tcp"
    port_range            = "1-65535"
    destination_addresses = ["0.0.0.0/0", "::/0"]
  }
  outbound_rule {
    protocol              = "udp"
    port_range            = "1-65535"
    destination_addresses = ["0.0.0.0/0", "::/0"]
  }
  outbound_rule {
    protocol              = "icmp"
    destination_addresses = ["0.0.0.0/0", "::/0"]
  }
}

resource "random_password" "es_elastic" {
  length  = 32
  special = false
}

resource "onepassword_item" "es_elastic" {
  vault      = data.onepassword_vault.cnh.uuid
  title      = var.es_password_item_title
  category   = "password"
  password   = random_password.es_elastic.result
  note_value = "Password of the elastic superuser on the single-node Elasticsearch in the wide-door namespace of ${var.name}. Generated by infra/node (ADR 0014); infra/node-platform reads it into the wide-door-es-elastic-user Secret."
}

resource "digitalocean_record" "widedoor" {
  count = var.publish_dns ? 1 : 0

  domain = var.domain
  type   = "A"
  name   = var.hostname
  value  = digitalocean_droplet.node.ipv4_address
  ttl    = 300
}

resource "digitalocean_project_resources" "node" {
  project   = data.digitalocean_project.cnh.id
  resources = [digitalocean_droplet.node.urn]
}
